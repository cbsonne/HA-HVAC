# Zugang zur bestehenden PostgreSQL-Datenbank.
# Läuft die Datenbank als Container auf demselben Pi, ist host.docker.internal der Host.
DB_URL=jdbc:postgresql://host.docker.internal:5432/solver
DB_USER=admin
DB_PASSWORD=bitte-eintragen

# Schema mit den Lüftungstabellen. Bei einem späteren Umbenennen nur hier ändern.
DB_SCHEMA=ventilation_milheiros

# Tabellen, die die Oberfläche nur anzeigt (Messreihen, Solver-Ergebnisse).
READ_ONLY_TABLES=sensor_values,actuator_values,solver_runs,solver_room_results,solver_actuator_results

# Einfacher Zugriffsschutz. Leeres Passwort = kein Schutz (nur im eigenen Netz sinnvoll).
APP_USER=admin
APP_PASSWORD=

WEB_PORT=8088
TZ=Europe/Lisbon
